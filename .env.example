# ─────────────────────────────────────────────────────────────
# Modèle de configuration — copier ce fichier en `.env` et remplir.
# Le vrai `.env` est ignoré par git (jamais versionné).
# ─────────────────────────────────────────────────────────────

# OBLIGATOIRE — clé API Anthropic (l'ideator qui propose les niches).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OBLIGATOIRE — DataForSEO (concurrence Amazon.fr + BSR fiable côté serveur).
# DATAFORSEO_PASSWORD = le MOT DE PASSE D'API (pas le mot de passe du compte),
# à récupérer sur https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OPTIONNEL — modèle de l'ideator (défaut : claude-sonnet-5).
# IDEATOR_MODEL=claude-sonnet-5

# OPTIONNEL — source du BSR :
#   scrape      = gratuit, via la fiche produit amazon.fr depuis ton IP (DÉFAUT, usage local)
#   dataforseo  = fiable côté serveur (IP datacenter), batché, payant (~0,0015-0,003 $/ASIN)
# BSR_SOURCE=scrape

# OPTIONNEL — Reddit API pour le mode « à partir de rien » (sinon mode RSS dégradé).
# Créer une app "script" sur https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kdp-scout/1.0
